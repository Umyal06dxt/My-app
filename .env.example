# Copy to .env.local and fill in. Never commit real keys.

# Public https address of this site. Must be in the API key's allowedOrigins (no trailing slash).
SITE_URL=https://shop.example.com

# Name shown in the header and page titles.
SITE_NAME=Little Live

# Secret key with checkout:write (server only).
TUNYT_SECRET_KEY=sk_live_...

# Key with events:read, used to list events. Either a publishable pk_live_ key whose
# allowedOrigins include SITE_URL, or a secret key with events:read.
# Leave empty if TUNYT_SECRET_KEY already has events:read.
TUNYT_EVENTS_KEY=

# Signing secret (whsec_...) of a webhook endpoint pointing at SITE_URL/api/tunyt/webhook. Optional.
TUNYT_WEBHOOK_SECRET=
